# 星火智教 · 环境变量模板
# 用法：复制本文件为 .env 并填入真实值（.env 已在 .gitignore，禁止提交/外传）
# 当前已验证：智谱 GLM（OpenAI 兼容）https://open.bigmodel.cn/api/paas/v4，模型 glm-4-flash

# OpenAI 兼容接口三件套（llm 模式必需）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=在此填入你的API_KEY
LLM_MODEL=glm-4-air

# 运行模式：mock（演示兜底）/ llm（真实生成）/ adp（WorkBuddy 接入，待实现）
# 不填则默认 mock
XHZH_MODE=llm

# ---------------------------------------------------------------------------
# 课件场景插图 · 可选"运行时生图"（默认关闭，留空即为不启用）
# ---------------------------------------------------------------------------
# 说明：课件场景卡默认使用 assets/visuals/ 下**经人工审核**的插画素材库；
# 只有素材缺失 + 下列三件套齐备 + XHZH_IMAGE_ALLOW=1 时才会调用外部文生图接口。
# 生图结果为 AIGC 图片，须人工过目、审核通过后方可进课堂（PPT 会自动加"AI 生成配图"水印）。
# 接口口径：OpenAI 兼容 POST {XHZH_IMAGE_BASE_URL}/images/generations
# 示例值留空 / 写占位符，禁止在此文件填写真实密钥。
XHZH_IMAGE_BASE_URL=
XHZH_IMAGE_API_KEY=
XHZH_IMAGE_MODEL=
# 显式开关：必须为 1 才允许运行时生图（默认 0 = 关闭，合规优先）
XHZH_IMAGE_ALLOW=0
# 单次请求超时（秒），非法值回退 60
XHZH_IMAGE_TIMEOUT=60

# ---------------------------------------------------------------------------
# MCP 服务（stdio 传输）· 可选
# ---------------------------------------------------------------------------
# 启动：python mcp_server.py
# 客户端配置（Claude Desktop / IDE）：
#   {"mcpServers":{"xinghuo-zhijiao":{"command":"python","args":["<项目路径>/mcp_server.py"]}}}
# 令牌：留空 = 本地单用户模式（默认授予 read + generate，不暴露网络端口）
# 填写后用于区分调用方身份（审计记录只存 sha256 前 8 位，不存明文）
XHZH_MCP_TOKEN=
# 授予的权限，逗号分隔：read,generate,admin（默认 read,generate）
# 仅作"只读演示"时可设为 read（此时 generate_teaching_package 会返回 FORBIDDEN）
XHZH_MCP_SCOPES=
# 任务级总预算（秒），超时置 failed 并回 TIMEOUT；默认 300（对齐 PRD「生成 ≤5 分钟」）
XHZH_MCP_TASK_TIMEOUT=300
# 生成并发：工作线程数与排队上限，超出返回 BUSY
XHZH_MCP_MAX_WORKERS=2
XHZH_MCP_MAX_QUEUE=4
# 每凭据每分钟最多起几个生成任务
XHZH_MCP_RATE_LIMIT_PER_MIN=6
